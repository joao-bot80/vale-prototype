        },
        {
          "speaker": "Lino",
          "es": "Son las dunas de Maspalomas. Al lado está el faro.",
          "pt": "São as dunas de Maspalomas. Do lado está o farol."
        },
        {
          "speaker": "Lu",
          "es": "¿Podemos caminar por las dunas?",
          "pt": "Podemos caminhar pelas dunas?"
        },
        {
          "speaker": "Lino",
          "es": "Solo por los senderos marcados. Es una reserva natural.",
          "pt": "Só pelas trilhas marcadas. É uma reserva natural."
        },
        {
          "speaker": "Lu",
          "es": "¡Qué calor! La arena quema.",
          "pt": "Que calor! A areia queima."
        },
        {
          "speaker": "Lino",
          "es": "Ponte las chanclas y bebe agua.",
          "pt": "Põe os chinelos e bebe água."
        }
