      "title": "Episódio 61: Arroz de forno",
      "lines": [
        {
          "speaker": "Lino",
          "es": "Hoy hacemos arroz al horno, el arroz de los lunes en muchas casas valencianas.",
          "pt": "Hoje fazemos arroz de forno, o arroz de segunda-feira em muitas casas valencianas."
        },
        {
          "speaker": "Lu",
          "es": "¿Qué lleva?",
          "pt": "O que leva?"
        },
        {
          "speaker": "Lino",
          "es": "Costilla de cerdo, morcilla, garbanzos, patata, tomate y una cabeza de ajos.",
          "pt": "Costela de porco, morcela, grão-de-bico, batata, tomate e uma cabeça de alho."
        },
        {
          "speaker": "Lu",
          "es": "¿Y se hace en la paella?",
          "pt": "E se faz na paella?"
        },
        {
          "speaker": "Lino",
          "es": "No, en una cazuela de barro, dentro del horno.",
          "pt": "Não, numa panela de barro, dentro do forno."
        },
        {
          "speaker": "Lu",
          "es": "Entonces compramos los garbanzos ya cocidos para ir más rápido.",
          "pt": "Então compramos o grão-de-bico já cozido para ir mais rápido."
        }
      ]
    },
