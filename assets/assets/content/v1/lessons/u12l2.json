        {
          "speaker": "Lu",
          "es": "¡Vale! ¿A qué hora quedamos?",
          "pt": "Beleza! Que horas a gente se encontra?"
        },
        {
          "speaker": "Dani",
          "es": "Sobre las nueve, en la plaza del Dos de Mayo.",
          "pt": "Lá pelas nove, na praça do Dos de Mayo."
        },
        {
          "speaker": "Lu",
          "es": "¿No es un poco pronto para cenar?",
          "pt": "Não é um pouco cedo para jantar?"
        },
        {
          "speaker": "Dani",
          "es": "Primero unas cañas y luego cenamos a las diez.",
          "pt": "Primeiro umas cervejas e depois jantamos às dez."
        },
        {
          "speaker": "Lu",
          "es": "Perfecto. ¡Hasta el viernes!",
          "pt": "Perfeito. Até sexta!"
        }
      ]
