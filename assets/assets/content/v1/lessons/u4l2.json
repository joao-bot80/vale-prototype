      "lines": [
        {
          "speaker": "Marta",
          "es": "¡Bon dia! Pasa, pasa. Este es el salón-comedor.",
          "pt": "Bom dia! Entra, entra. Esta é a sala de estar e jantar."
        },
        {
          "speaker": "Lu",
          "es": "¡Qué luminoso! ¿El piso está amueblado?",
          "pt": "Que iluminado! O apartamento é mobiliado?"
        },
        {
          "speaker": "Marta",
          "es": "Sí, tiene todos los muebles y la cocina está equipada.",
          "pt": "Sim, tem todos os móveis e a cozinha é equipada."
        },
        {
          "speaker": "Lu",
          "es": "¿Hay calefacción?",
          "pt": "Tem aquecimento?"
        },
        {
          "speaker": "Marta",
          "es": "Sí, y aire acondicionado en el dormitorio.",
          "pt": "Sim, e ar-condicionado no quarto."
        },
        {
          "speaker": "Lu",
          "es": "Me encanta. ¿Cuándo podría entrar a vivir?",
          "pt": "Adorei. Quando eu poderia me mudar?"
        }
      ]
