        {
          "speaker": "Jefa",
          "es": "¡Bienvenida, Lu! Te presento al equipo.",
          "pt": "Bem-vinda, Lu! Vou te apresentar à equipe."
        },
        {
          "speaker": "Lu",
          "es": "Encantada. ¿A qué hora empezamos por la mañana?",
          "pt": "Prazer. A que horas começamos de manhã?"
        },
        {
          "speaker": "Jefa",
          "es": "Entramos a las nueve y salimos a las seis, con una hora para comer.",
          "pt": "Entramos às nove e saímos às seis, com uma hora de almoço."
        },
        {
          "speaker": "Lu",
          "es": "¿Y dónde está mi mesa?",
          "pt": "E onde fica minha mesa?"
        },
        {
          "speaker": "Jefa",
          "es": "Al lado de la ventana. Si tienes dudas, pregúntale a Carlos.",
          "pt": "Ao lado da janela. Se tiver dúvidas, pergunte ao Carlos."
        },
        {
          "speaker": "Lu",
          "es": "Genial. Muchas gracias por todo.",
          "pt": "Ótimo. Muito obrigada por tudo."
        }
      ]
