      "lines": [
        {
          "speaker": "Lino",
          "es": "Cuando el sidrero grita «¡txotx!», vamos todos a la kupela.",
          "pt": "Quando o sidreiro grita «txotx!», todos vamos ao barril."
        },
        {
          "speaker": "Lu",
          "es": "¿Y cómo se bebe?",
          "pt": "E como se bebe?"
        },
        {
          "speaker": "Lino",
          "es": "Pones el vaso inclinado, recoges un poco de sidra y dejas sitio al siguiente.",
          "pt": "Você põe o copo inclinado, pega um pouco de sidra e dá lugar ao próximo."
        },
        {
          "speaker": "Lu",
          "es": "¿Y el menú?",
          "pt": "E o cardápio?"
        },
        {
          "speaker": "Lino",
          "es": "Tortilla de bacalao, chuletón y de postre queso con membrillo y nueces.",
          "pt": "Omelete de bacalhau, bisteca grande e, de sobremesa, queijo com marmelada e nozes."
        },
        {
          "speaker": "Lu",
          "es": "¡Se come de pie y se bebe mucho! Me encanta.",
          "pt": "Se come em pé e se bebe muito! Adoro."
        }
      ]
