        {
          "speaker": "Pediatra",
          "es": "Hola. ¿Qué le pasa a la niña?",
          "pt": "Olá. O que a menina tem?"
        },
        {
          "speaker": "Lu",
          "es": "Tiene fiebre desde ayer y le duele la garganta.",
          "pt": "Está com febre desde ontem e a garganta dói."
        },
        {
          "speaker": "Pediatra",
          "es": "A ver, abre la boca. Tiene las anginas inflamadas.",
          "pt": "Vamos ver, abre a boca. Está com as amígdalas inflamadas."
        },
        {
          "speaker": "Lu",
          "es": "¿Necesita antibiótico?",
          "pt": "Precisa de antibiótico?"
        },
        {
          "speaker": "Pediatra",
          "es": "De momento no. Paracetamol, mucho líquido y si sigue con fiebre en tres días, vuelve.",
          "pt": "Por enquanto não. Paracetamol, muito líquido e, se continuar com febre em três dias, volte."
        },
        {
          "speaker": "Lu",
          "es": "Vale. ¿Y tiene todas las vacunas al día?",
          "pt": "Certo. E ela está com todas as vacinas em dia?"
        }
