      "lines": [
        {
          "speaker": "Lino",
          "es": "Esta noche hacemos una queimada.",
          "pt": "Hoje à noite fazemos uma queimada."
        },
        {
          "speaker": "Lu",
          "es": "¿Qué es exactamente?",
          "pt": "O que é exatamente?"
        },
        {
          "speaker": "Lino",
          "es": "Aguardiente con azúcar, piel de limón y granos de café. Se le prende fuego.",
          "pt": "Aguardente com açúcar, casca de limão e grãos de café. Põe-se fogo nela."
        },
        {
          "speaker": "Lu",
          "es": "¿Y por qué apagan las luces?",
          "pt": "E por que apagam as luzes?"
        },
        {
          "speaker": "Lino",
          "es": "Porque alguien recita el conjuro para espantar a las meigas, las brujas.",
          "pt": "Porque alguém recita o conjuro para espantar as meigas, as bruxas."
        },
        {
          "speaker": "Lu",
          "es": "Me da un poco de miedo... ¡pero me encanta!",
          "pt": "Me dá um pouco de medo... mas eu adoro!"
        }
