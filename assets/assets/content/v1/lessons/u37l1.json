      "lines": [
        {
          "speaker": "Lu",
          "es": "¡Qué alto es el Teide! ¿Cuánto mide?",
          "pt": "Que alto é o Teide! Quanto mede?"
        },
        {
          "speaker": "Lino",
          "es": "Unos tres mil setecientos metros. Es el pico más alto de España.",
          "pt": "Uns três mil e setecentos metros. É o pico mais alto da Espanha."
        },
        {
          "speaker": "Lu",
          "es": "¿Se puede subir hasta la cima?",
          "pt": "Dá para subir até o cume?"
        },
        {
          "speaker": "Lino",
          "es": "El teleférico llega cerca. Para el último tramo hace falta un permiso.",
          "pt": "O teleférico chega perto. Para o último trecho precisa de uma autorização."
        },
        {
          "speaker": "Lu",
          "es": "Arriba hace frío, ¿no?",
          "pt": "Lá em cima faz frio, né?"
        },
        {
          "speaker": "Lino",
          "es": "Mucho. Abajo playa, arriba abrigo. Así es Tenerife.",
          "pt": "Muito. Embaixo praia, em cima casaco. Assim é Tenerife."
        }
      ]
