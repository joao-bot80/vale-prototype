          "speaker": "Lino",
          "es": "¿Desayunas en casa?",
          "pt": "Toma café da manhã em casa?"
        },
        {
          "speaker": "Lu",
          "es": "No, desayuno un café con tostada en el bar de abajo.",
          "pt": "Não, tomo um café com torrada no bar de baixo."
        },
        {
          "speaker": "Lino",
          "es": "¿Y por la noche?",
          "pt": "E à noite?"
        },
        {
          "speaker": "Lu",
          "es": "Ceno sobre las nueve y me acuesto a las doce. ¡Muy española!",
          "pt": "Janto lá pelas nove e vou dormir à meia-noite. Muito espanhola!"
        }
      ]
