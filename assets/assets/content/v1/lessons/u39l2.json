      "lines": [
        {
          "speaker": "Lu",
          "es": "¿Qué es este polvo marrón?",
          "pt": "Que pó marrom é esse?"
        },
        {
          "speaker": "Lino",
          "es": "Es gofio: harina de cereales tostados. Muy canario.",
          "pt": "É gofio: farinha de cereais torrados. Bem canário."
        },
        {
          "speaker": "Lu",
          "es": "¿Cómo se toma?",
          "pt": "Como se come?"
        },
        {
          "speaker": "Lino",
          "es": "Con leche, en caldo o amasado. Mi abuela lo pone en todo.",
          "pt": "Com leite, no caldo ou amassado. Minha avó põe em tudo."
        },
        {
          "speaker": "Lu",
          "es": "¿Y ese queso?",
          "pt": "E esse queijo?"
        },
        {
          "speaker": "Lino",
          "es": "Queso de flor de Guía. Pruébalo con miel de palma.",
          "pt": "Queijo de flor de Guía. Prova com mel de palma."
