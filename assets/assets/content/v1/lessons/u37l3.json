        {
          "speaker": "Lu",
          "es": "¿Cómo vamos a La Laguna?",
          "pt": "Como vamos a La Laguna?"
        },
        {
          "speaker": "Lino",
          "es": "En guagua. Aquí el autobús se llama guagua.",
          "pt": "De guagua. Aqui o ônibus se chama guagua."
        },
        {
          "speaker": "Lu",
          "es": "¡Qué palabra tan simpática! ¿Y el tranvía?",
          "pt": "Que palavra simpática! E o bonde?"
        },
        {
          "speaker": "Lino",
          "es": "También hay tranvía desde Santa Cruz. Pero hoy, guagua.",
          "pt": "Também tem bonde desde Santa Cruz. Mas hoje, guagua."
        },
        {
          "speaker": "Lu",
          "es": "La ciudad tiene calles rectas y casas de colores.",
          "pt": "A cidade tem ruas retas e casas coloridas."
        },
        {
          "speaker": "Lino",
          "es": "Es Patrimonio de la Humanidad. Su plano inspiró ciudades de América.",
          "pt": "É Patrimônio da Humanidade. Seu traçado inspirou cidades da América."
        }
