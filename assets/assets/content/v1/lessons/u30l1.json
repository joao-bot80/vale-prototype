      "title": "Episódio 88: A festa de formatura",
      "lines": [
        {
          "speaker": "Lu",
          "es": "El sábado hago una fiesta para celebrar que he terminado el curso.",
          "pt": "No sábado faço uma festa para comemorar que terminei o curso."
        },
        {
          "speaker": "Dani",
          "es": "¡Enhorabuena! ¿Qué llevo?",
          "pt": "Parabéns! O que eu levo?"
        },
        {
          "speaker": "Lu",
          "es": "Trae hielo y unas patatas. Marta trae la tortilla.",
          "pt": "Traz gelo e umas batatinhas. A Marta traz a tortilha."
        },
        {
          "speaker": "Dani",
          "es": "¿Con cebolla o sin cebolla?",
          "pt": "Com cebola ou sem cebola?"
        },
        {
          "speaker": "Lu",
          "es": "¡Ni se te ocurra empezar ese debate!",
          "pt": "Nem pense em começar esse debate!"
        },
        {
          "speaker": "Dani",
          "es": "Jaja, vale. ¿A qué hora empieza?",
          "pt": "Haha, beleza. Que horas começa?"
        }
      ]
    },
